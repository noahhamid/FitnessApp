DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
# Production API (Vercel). For local server use your LAN IP + PORT instead.
BETTER_AUTH_URL=https://potential-peak.vercel.app
# Gemini is server-side only. Keep this key private and never expose it to the client bundle.
GEMINI_API_KEY=
PORT=3000

# Expo client — baked into EAS preview/production via eas.json env.
# Local device testing against your machine: use http://YOUR_LAN_IP:3000
EXPO_PUBLIC_API_URL=https://potential-peak.vercel.app
EXPO_PUBLIC_BETTER_AUTH_URL=https://potential-peak.vercel.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
APPLE_APP_BUNDLE_IDENTIFIER=com.exo.fitness
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Resend transactional email (auth verify / reset / delete-account).
# PRE-LAUNCH BLOCKER: sandbox only — FROM must be onboarding@resend.dev and
# mail only delivers to the Resend account owner until a domain is verified.
# Example sandbox FROM: PotentialPeak <onboarding@resend.dev>
RESEND_API_KEY=
RESEND_FROM_EMAIL=PotentialPeak <onboarding@resend.dev>

# Vercel Blob — required on Vercel for meal-scan photo uploads.
# Create in Vercel Dashboard → Storage → Blob → .env local / project env.
BLOB_READ_WRITE_TOKEN=

# Sentry crash reporting (client). Create a React Native project at sentry.io
# and paste the DSN here / into EAS env for preview+production.
EXPO_PUBLIC_SENTRY_DSN=
