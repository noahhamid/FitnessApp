# Copy to .env.local and fill in. Never commit real secrets.
#   cp .env.example .env.local
#
# Client vars (EXPO_PUBLIC_*) are baked into the app binary.
# Server vars live on Vercel (and in .env.local for `npm run dev:server`).
# EAS preview/production already set the EXPO_PUBLIC_* values in eas.json.

# --- Local API ---
PORT=3000
HOST=0.0.0.0

# --- Database (Neon) ---
# Pooled URL for the running API. Direct URL for Prisma migrate.
DATABASE_URL=
DIRECT_URL=

# --- Better Auth ---
BETTER_AUTH_SECRET=
# Public origin of the API (local: http://YOUR_LAN_IP:3000, prod: https://…vercel.app)
BETTER_AUTH_URL=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_BETTER_AUTH_URL=

# --- Google sign-in ---
# Web client ID + secret on the server. Same web client ID on the device.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Apple sign-in (optional; native idToken works without these) ---
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=com.exo.fitness

# --- Email (Resend) ---
# Production sign-up requires a verified domain on the From address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Email verification (optional hard gate) ---
# When true on the API, Better Auth blocks sign-in until email is verified
# (breaks "I'll confirm later"). Leave unset/false for production unless
# you also set EXPO_PUBLIC_REQUIRE_EMAIL_VERIFICATION=true in the app build.
REQUIRE_EMAIL_VERIFICATION=
EXPO_PUBLIC_REQUIRE_EMAIL_VERIFICATION=

# --- Auth rate limits ---
# Production: on by default. Disable with either:
#   ENABLE_AUTH_RATE_LIMIT=false
#   DISABLE_AUTH_RATE_LIMIT=true
ENABLE_AUTH_RATE_LIMIT=
DISABLE_AUTH_RATE_LIMIT=

# --- Meal scan (Gemini) + meal photos (Vercel Blob) ---
GEMINI_API_KEY=
BLOB_READ_WRITE_TOKEN=

# --- Crash reporting ---
# App crashes (@sentry/react-native). Public — ships in the app bundle.
EXPO_PUBLIC_SENTRY_DSN=
# API errors (@sentry/node). Server only — set on Vercel, not in EAS.
SENTRY_DSN=

# --- Exercise images (Cloudinary) ---
# Client only needs the cloud name (public). Upload needs URL or key+secret.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_FOLDER=potential-peak/exercises
# Preferred for uploads:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=potential-peak/exercises

# --- In-app purchases (server verification) ---
# Production refuses Pro unless Apple/Google confirm the receipt.
# iOS: the app sends a StoreKit 2 JWS; the API verifies it locally
# (no Apple key required for /sync). Notifications still need the URL below.
# Android: Play Developer API service account is required.
APPLE_IAP_BUNDLE_ID=com.exo.fitness
# App Store Connect → Users and Access → Integrations → In-App Purchase
# (only needed if you later add server-side transaction lookups):
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=

GOOGLE_PLAY_PACKAGE_NAME=com.exo.fitness
# Paste the full service-account JSON as one line, or split email + key.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=

# Local device testing without store credentials. Ignored on Vercel production.
IAP_SKIP_VERIFY=
