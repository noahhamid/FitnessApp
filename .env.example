# Server (Hono + Prisma)
DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://192.168.0.150:3000
# Gemini is server-side only. Keep this key private and never expose it to the client bundle.
GEMINI_API_KEY=
PORT=3000

# Expo client — use your machine's LAN IP so physical devices can reach the API
EXPO_PUBLIC_API_URL=http://192.168.0.150:3000
EXPO_PUBLIC_BETTER_AUTH_URL=http://192.168.0.150:3000

# Google Cloud *Web* OAuth client (Better Auth + native Google idToken)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Apple Sign In — native idToken uses APPLE_APP_BUNDLE_IDENTIFIER (App ID).
# APPLE_CLIENT_ID / APPLE_CLIENT_SECRET (Service ID + JWT) needed for web OAuth.
APPLE_APP_BUNDLE_IDENTIFIER=com.exo.fitness
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
