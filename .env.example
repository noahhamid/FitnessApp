# Server (Hono + Prisma) — set these in the Vercel project dashboard for deploys
DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
# Production API (Vercel). For local server use your LAN IP + PORT instead.
BETTER_AUTH_URL=https://potentialpeak-app.vercel.app
# Gemini is server-side only. Keep this key private and never expose it to the client bundle.
GEMINI_API_KEY=
PORT=3000

# Expo client — baked into EAS preview/production via eas.json env.
# Local device testing against your machine: use http://YOUR_LAN_IP:3000
EXPO_PUBLIC_API_URL=https://potentialpeak-app.vercel.app
EXPO_PUBLIC_BETTER_AUTH_URL=https://potentialpeak-app.vercel.app
