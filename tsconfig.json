{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "src/routes/**/*.ts",
    "src/middleware/**/*.ts",
    "src/lib/**/*.ts",
    "src/types/**/*.ts",
    "api/**/*.ts",
    "src/app.ts",
    "src/index.ts"
  ],
  "exclude": [
    "node_modules",
    "__tests__",
    "src/lib/workout-split.ts",
    "prisma/**",
    "prisma.config.ts",
    ".expo",
    ".expo-web-test",
    ".expo-web-test2"
  ]
}
