{
  "name": "trainplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "free:port": "node scripts/free-port.mjs 3000",
    "dev:server": "node scripts/dev-server.mjs",
    "server": "node scripts/free-port.mjs 3000 ; npx tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "auth:clear-rate-limits": "node scripts/clear-auth-rate-limits.mjs",
    "dev:grant-premium": "node scripts/grant-premium.mjs",
    "media:upload-exercises": "node scripts/upload-exercise-images-cloudinary.mjs",
    "media:extract-exercise-ids": "node scripts/extract-exercise-image-ids.mjs",
    "postinstall": "prisma generate",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
