{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "buildCommand": "npx prisma generate && node scripts/bundle-api.cjs",
  "functions": {
    "api/index.ts": {
      "includeFiles": "api/handler.cjs"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
